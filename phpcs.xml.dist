<?xml version="1.0"?>
<ruleset name="Media Dependency Map">
  <description>WordPress standards for production PHP.</description>
  <file>media-dependency-map</file>
  <arg name="extensions" value="php"/>
  <rule ref="WordPress"/>
  <rule ref="WordPress.WP.Capabilities">
    <properties>
      <property name="custom_capabilities" type="array">
        <element value="mdm_view_dependencies"/>
        <element value="mdm_run_scans"/>
        <element value="mdm_replace_references"/>
        <element value="mdm_manage_settings"/>
      </property>
    </properties>
  </rule>
  <config name="minimum_supported_wp_version" value="6.6"/>
</ruleset>
